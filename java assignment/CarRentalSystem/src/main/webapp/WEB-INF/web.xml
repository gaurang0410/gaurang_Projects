<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_5_0.xsd"
         version="5.0"
         metadata-complete="true">

    <display-name>Car Rental System</display-name>

    <!-- ADMIN SERVLETS -->
    <servlet>
        <servlet-name>DashboardServlet</servlet-name>
        <servlet-class>servlet.DashboardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DashboardServlet</servlet-name>
        <url-pattern>/admin/dashboard</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ViewCarsServlet</servlet-name>
        <servlet-class>servlet.ViewCarsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ViewCarsServlet</servlet-name>
        <url-pattern>/admin/cars</url-pattern>
        <url-pattern>/customer/viewCars</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AddCarServlet</servlet-name>
        <servlet-class>servlet.AddCarServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AddCarServlet</servlet-name>
        <url-pattern>/admin/addCar</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>EditCarServlet</servlet-name>
        <servlet-class>servlet.EditCarServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>EditCarServlet</servlet-name>
        <url-pattern>/admin/editCar</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>DeleteCarServlet</servlet-name>
        <servlet-class>servlet.DeleteCarServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DeleteCarServlet</servlet-name>
        <url-pattern>/admin/deleteCar</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ManageBookingsServlet</servlet-name>
        <servlet-class>servlet.ManageBookingsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ManageBookingsServlet</servlet-name>
        <url-pattern>/admin/bookings</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ManageCustomersServlet</servlet-name>
        <servlet-class>servlet.ManageCustomersServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ManageCustomersServlet</servlet-name>
        <url-pattern>/admin/customers</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ManagePaymentsServlet</servlet-name>
        <servlet-class>servlet.ManagePaymentsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ManagePaymentsServlet</servlet-name>
        <url-pattern>/admin/payments</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ManageReviewsServlet</servlet-name>
        <servlet-class>servlet.ManageReviewsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ManageReviewsServlet</servlet-name>
        <url-pattern>/admin/reviews</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ReviewModerationServlet</servlet-name>
        <servlet-class>servlet.ReviewModerationServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ReviewModerationServlet</servlet-name>
        <url-pattern>/admin/moderateReview</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>UpdateBookingStatusServlet</servlet-name>
        <servlet-class>servlet.UpdateBookingStatusServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>UpdateBookingStatusServlet</servlet-name>
        <url-pattern>/admin/updateBookingStatus</url-pattern>
    </servlet-mapping>

    <!-- CUSTOMER SERVLETS -->
    <servlet>
        <servlet-name>CustomerDashboardServlet</servlet-name>
        <servlet-class>servlet.CustomerDashboardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CustomerDashboardServlet</servlet-name>
        <url-pattern>/customer/dashboard</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>BookingServlet</servlet-name>
        <servlet-class>servlet.BookingServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>BookingServlet</servlet-name>
        <url-pattern>/customer/bookCar</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>MyBookingsServlet</servlet-name>
        <servlet-class>servlet.MyBookingsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>MyBookingsServlet</servlet-name>
        <url-pattern>/customer/bookings</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>PaymentServlet</servlet-name>
        <servlet-class>servlet.PaymentServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PaymentServlet</servlet-name>
        <url-pattern>/customer/payment</url-pattern>
        <url-pattern>/customer/processPayment</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ReviewServlet</servlet-name>
        <servlet-class>servlet.ReviewServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ReviewServlet</servlet-name>
        <url-pattern>/customer/review</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>InvoiceServlet</servlet-name>
        <servlet-class>servlet.InvoiceServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>InvoiceServlet</servlet-name>
        <url-pattern>/customer/invoice</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>InvoiceGeneratorServlet</servlet-name>
        <servlet-class>servlet.InvoiceGeneratorServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>InvoiceGeneratorServlet</servlet-name>
        <url-pattern>/customer/generateInvoice</url-pattern>
    </servlet-mapping>

    <!-- COMMON SERVLETS -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>servlet.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>servlet.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>RegisterServlet</servlet-name>
        <servlet-class>servlet.RegisterServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RegisterServlet</servlet-name>
        <url-pattern>/register</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ForgotPasswordServlet</servlet-name>
        <servlet-class>servlet.ForgotPasswordServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ForgotPasswordServlet</servlet-name>
        <url-pattern>/forgotPassword</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ResetPasswordServlet</servlet-name>
        <servlet-class>servlet.ResetPasswordServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ResetPasswordServlet</servlet-name>
        <url-pattern>/resetPassword</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>SettingsServlet</servlet-name>
        <servlet-class>servlet.SettingsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SettingsServlet</servlet-name>
        <url-pattern>/settings</url-pattern>
    </servlet-mapping>

    <!-- FILTERS -->
    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>filter.AuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
            <secure>false</secure>
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

</web-app>
